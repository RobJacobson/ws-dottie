meta {
  name: SearchWeatherInformation
  type: http
  seq: 4
}

get {
  url: {{wsdot_weather_information_base_url}}/SearchWeatherInformationAsJson?AccessCode={{WSDOT_ACCESS_TOKEN}}&StationID={{station_id}}&SearchStartTime={{search_start_time}}&SearchEndTime={{search_end_time}}
  body: none
  auth: inherit
}

params:query {
  AccessCode: {{WSDOT_ACCESS_TOKEN}}
  StationID: {{station_id}}
  SearchStartTime: {{search_start_time}}
  SearchEndTime: {{search_end_time}}
}
