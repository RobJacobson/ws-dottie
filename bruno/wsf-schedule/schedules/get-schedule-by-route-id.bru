meta {
  name: GetScheduleByRouteId
  type: http
  seq: 1
}

get {
  url: {{wsf_schedule_base_url}}/schedule/{{trip_date}}/{{route_id}}?apiaccesscode={{WSDOT_ACCESS_TOKEN}}
  body: none
  auth: inherit
}

params:query {
  apiaccesscode: {{WSDOT_ACCESS_TOKEN}}
}

vars:pre-request {
  trip_date: 2026-12-20
  route_id: 9
}
