meta {
  name: GetTodaysScheduleByTerminalCombo
  type: http
  seq: 2
}

get {
  url: {{wsf_schedule_base_url}}/scheduletoday/{{departing_terminal_id}}/{{arriving_terminal_id}}/{{only_remaining_times}}?apiaccesscode={{WSDOT_ACCESS_TOKEN}}
  body: none
  auth: inherit
}

params:query {
  apiaccesscode: {{WSDOT_ACCESS_TOKEN}}
}

vars:pre-request {
  departing_terminal_id: 7
  arriving_terminal_id: 3
  only_remaining_times: false
}
