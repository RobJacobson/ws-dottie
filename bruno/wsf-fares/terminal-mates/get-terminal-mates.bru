meta {
  name: GetFaresTerminalMates
  type: http
  seq: 1
}

get {
  url: {{wsf_fares_base_url}}/terminalmates/{{trip_date}}/{{terminal_id}}?apiaccesscode={{WSDOT_ACCESS_TOKEN}}
  body: none
  auth: inherit
}

params:query {
  apiaccesscode: {{WSDOT_ACCESS_TOKEN}}
}

vars:pre-request {
  trip_date: 2026-12-20
  terminal_id: 1
}
