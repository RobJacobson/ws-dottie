meta {
  name: GetFareLineItemsBasic
  type: http
  seq: 2
}

get {
  url: {{wsf_fares_base_url}}/farelineitemsbasic/{{trip_date}}/{{departing_terminal_id}}/{{arriving_terminal_id}}/{{round_trip}}?apiaccesscode={{WSDOT_ACCESS_TOKEN}}
  body: none
  auth: inherit
}

params:query {
  apiaccesscode: {{WSDOT_ACCESS_TOKEN}}
}

vars:pre-request {
  trip_date: 2026-12-20
  departing_terminal_id: 7
  arriving_terminal_id: 3
  round_trip: false
}
