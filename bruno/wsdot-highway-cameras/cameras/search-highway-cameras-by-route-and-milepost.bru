meta {
  name: SearchHighwayCamerasByRouteAndMilepost
  type: http
  seq: 2
}

get {
  url: {{wsdot_highway_cameras_base_url}}/SearchCamerasAsJson?AccessCode={{WSDOT_ACCESS_TOKEN}}&StateRoute={{camera_state_route}}&StartingMilepost={{starting_milepost}}&EndingMilepost={{ending_milepost}}
  body: none
  auth: inherit
}

params:query {
  AccessCode: {{WSDOT_ACCESS_TOKEN}}
  StateRoute: {{camera_state_route}}
  StartingMilepost: {{starting_milepost}}
  EndingMilepost: {{ending_milepost}}
}
