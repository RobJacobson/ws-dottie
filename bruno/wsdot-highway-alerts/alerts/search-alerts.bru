meta {
  name: SearchAlerts
  type: http
  seq: 5
}

get {
  url: {{wsdot_highway_alerts_base_url}}/SearchAlertsAsJson?AccessCode={{WSDOT_ACCESS_TOKEN}}&StateRoute={{state_route}}&SearchTimeStart={{search_time_start}}&SearchTimeEnd={{search_time_end}}&StartingMilepost={{starting_milepost}}&EndingMilepost={{ending_milepost}}
  body: none
  auth: inherit
}

params:query {
  AccessCode: {{WSDOT_ACCESS_TOKEN}}
  StateRoute: {{state_route}}
  SearchTimeStart: {{search_time_start}}
  SearchTimeEnd: {{search_time_end}}
  StartingMilepost: {{starting_milepost}}
  EndingMilepost: {{ending_milepost}}
}
